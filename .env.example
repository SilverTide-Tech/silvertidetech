# Copy to .env for local development. NEVER commit .env. On Vercel, add these in
# Project Settings -> Environment Variables (Production and Preview), then redeploy.

# ---- Gemini keys (server-side only; never expose to the browser) ----
# Round robin: requests rotate across the keys. If one key runs out of quota (or is invalid),
# the next key is used automatically. Use ONE of the three styles below.

# Style 1 (simplest): comma-separated list, no spaces needed
GEMINI_API_KEYS=

# Style 2: numbered keys (add as many as you like)
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Style 3: a single key
# GEMINI_API_KEY=

# Model id (default gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: extra origins allowed to call /api/ask, comma-separated (same-origin and localhost always work)
# AI_ALLOWED_ORIGINS=https://www.example.com

# Optional abuse limits (best effort, per server instance)
# AI_DAILY_LIMIT=400
# AI_RATE_PER_10MIN=30

# Existing, optional: production domain for canonical URLs and sitemap
# SITE_URL=https://www.example.com
