---
/**
 * Contact (architecture §4, Form template). Contact details (email, address) are not shown because
 * the founders have not supplied them yet (company-vision §10 item 3). The form validates input but
 * does not deliver messages until a form endpoint is chosen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import TideStroke from '../components/ui/TideStroke.astro';
import ContactForm from '../components/react/ContactForm';
import { CONTACT_TOPICS } from '../lib/company';
---

<BaseLayout
  title="Contact"
  description="Contact Silver Tide Tech with a question, an idea or a project. Choose a topic so your message reaches the right people."
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk"
    intro="Have an idea, a question or a project in mind? Send us a message."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contact', href: '/contact' }]}
  />

  <section aria-labelledby="form-title" class="py-16 lg:py-24">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div class="grid content-start gap-4">
        <TideStroke />
        <h2 id="form-title" class="text-h2 font-bold">Send a message</h2>
        <p>Choose the topic that fits best so your message reaches the right people.</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-silver-200 bg-white p-6 sm:p-9">
        <ContactForm client:visible topics={CONTACT_TOPICS} />
      </div>
    </div>
  </section>
</BaseLayout>
