---
/**
 * Legal template (architecture §5): title · last-updated date · long-form prose.
 * Text must be founder-supplied or legally reviewed; until then the page states that plainly
 * and stays out of search results.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';

interface Props {
  title: string;
  href: string;
  /** ISO date of the reviewed text; omit while the document is being prepared. */
  lastUpdated?: string;
}

const { title, href, lastUpdated } = Astro.props;
const ready = Astro.slots.has('default');
---

<BaseLayout title={title} description={`The ${title} of Silver Tide Tech, the product-led technology and innovation company.`} noindex={!ready}>
  <PageHero eyebrow="Legal" title={title} breadcrumbs={[{ label: 'Home', href: '/' }, { label: title, href }]} />
  <section aria-label={title} class="py-16 lg:py-24">
    <div class="container-site">
      <div class="max-w-[68ch]">
        {
          lastUpdated && (
            <p class="text-sm text-ink-500">
              Last updated: <time datetime={lastUpdated}>{new Date(lastUpdated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </p>
          )
        }
        {
          ready ? (
            <div class="mt-6 grid gap-5 [&_h2]:mt-6 [&_h2]:text-h3 [&_h2]:font-semibold">
              <slot />
            </div>
          ) : (
            <div class="rounded-[var(--radius-card)] border border-silver-200 bg-mist p-6 sm:p-8">
              <p class="text-lead text-navy-900">This document is being prepared.</p>
              <p class="mt-3">
                Our {title.toLowerCase()} will be published here once it has been finalised. If you have a question in the
                meantime, please use our <a href="/contact" class="font-medium text-teal-700 underline underline-offset-4">contact page</a>.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
