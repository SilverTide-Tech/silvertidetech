---
/** The signature tide stroke (brand-direction §6.2). */
import { TIDE_STROKE_PATH } from '../../lib/brand';

interface Props {
  class?: string;
  tone?: 'light' | 'dark';
}

const { class: className, tone = 'light' } = Astro.props;
---

<svg
  width="40"
  height="8"
  viewBox="0 0 40 8"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={['tide-draw block overflow-visible', className]}
>
  <path d={TIDE_STROKE_PATH} stroke={tone === 'dark' ? '#5FE3D6' : '#14B3A8'} stroke-width="2.2" stroke-linecap="round"
  ></path>
</svg>
