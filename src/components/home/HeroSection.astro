---
/** Home §1 Hero: introduce Silver Tide Tech in one glance (architecture §3). */
import Button from '../ui/Button.astro';
import TideStroke from '../ui/TideStroke.astro';
import TideField from '../react/TideField';
import HeroVisual from './HeroVisual.astro';
import { SITE } from '../../lib/site';
---

<section aria-labelledby="hero-title" class="aurora grain spot relative isolate overflow-hidden" data-spot data-tone="dark" data-tide-host>
  <!-- Readability scrim (z-1) sits above the tide lines (z-auto) and below the copy (z-10). -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-r from-navy-900 from-15% via-navy-900/55 to-navy-900/10"
    aria-hidden="true"
  >
  </div>

  <HeroVisual />

  <div class="container-site relative z-10 pt-24 pb-32 sm:pt-28 lg:min-h-[44rem] lg:pt-36 lg:pb-44">
    <div class="max-w-[50rem]">
      <p class="eyebrow hero-in text-teal-300">{SITE.identity}</p>
      <TideStroke tone="dark" class="mt-4" />
      <h1 id="hero-title" class="hero-in mt-5 text-[clamp(2.75rem,1.6rem+5.2vw,5.75rem)] leading-[1.02] font-extrabold tracking-[-0.035em] text-white" style="--d:120ms">
        Building Technology.<br /><span class="text-metal">Empowering People.</span>
      </h1>
      <p class="hero-in mt-6 max-w-[38rem] text-lead text-silver-300" style="--d:260ms">
        Silver Tide Tech is a product-led technology and innovation company. We build products, digital platforms and
        solutions that solve real-world problems.
      </p>
      <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:380ms">
        <Button href="/businesses" variant="accent" tone="dark" arrow>Explore our businesses</Button>
        <Button href="/products/sarastech" variant="secondary" tone="dark">Discover SarasTech</Button>
      </div>
    </div>
  </div>

  <a
    href="#build-title"
    class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-silver-300 hover:text-white md:flex"
  >
    <span class="eyebrow">Scroll</span>
    <span class="sr-only">to our businesses</span>
    <span class="scroll-cue relative block h-10 w-px overflow-hidden bg-navy-700" aria-hidden="true"></span>
  </a>

  <!-- After the copy in DOM order so the pause control follows the CTAs in the tab sequence. -->
  <TideField client:idle />
</section>
