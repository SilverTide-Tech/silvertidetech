---
/**
 * Founder card (brand-direction §8.4). Every profile uses the same 4:5 portrait frame and one photo
 * treatment (silver tone, §6.4) so headshots taken in different settings read as one set.
 * Profiles without a photo yet show a placeholder in the same frame.
 * On hover the photo eases in 3% and some colour returns (300 ms); no zoom under reduced motion.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getInitials } from '../../lib/people';

interface Props {
  name: string;
  designation?: string;
  photo?: ImageMetadata;
  photoPosition?: string;
  /** Varies which placeholder tide line is teal. */
  index: number;
  /** Load the photo eagerly when the grid is above the fold (Leadership page). */
  eager?: boolean;
}

const { name, designation, photo, photoPosition = '50% 30%', index, eager = false } = Astro.props;
const accent = (index % 5) + 1;

const lines = Array.from({ length: 7 }, (_, i) => {
  const y = (250 / 8) * (i + 1);
  let d = '';
  for (let x = 0; x <= 200; x += 10) {
    d += `${x === 0 ? 'M' : 'L'}${x} ${(y + (5 + (i % 3) * 2) * Math.sin(((x + i * 30) / 140) * Math.PI * 2)).toFixed(1)}`;
  }
  return { d, accent: i === accent };
});
---

<li class="group overflow-hidden rounded-[var(--radius-card)] border border-silver-200 bg-white">
  <div class="tilt relative aspect-[4/5] overflow-hidden bg-silver-100" data-tilt>
    {
      photo ? (
        <>
          <Picture
            src={photo}
            alt=""
            formats={['avif', 'webp']}
            widths={[240, 360, 480, 640]}
            sizes="(min-width: 1024px) 224px, (min-width: 640px) 31vw, 46vw"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager && index === 0 ? 'high' : undefined}
            class="h-full w-full object-cover grayscale-[0.92] contrast-[1.04] transition-[filter,scale] duration-300 ease-[var(--ease-tide-out)] group-hover:grayscale-[0.6] motion-safe:group-hover:scale-[1.03]"
            style={`object-position: ${photoPosition}`}
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-900/25 via-transparent to-transparent" aria-hidden="true" />
        </>
      ) : (
        <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-silver-100 to-mist" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 200 250" preserveAspectRatio="none" focusable="false">
            {lines.map((l) => (
              <path d={l.d} fill="none" stroke={l.accent ? '#14B3A8' : '#A9B4C2'} stroke-opacity={l.accent ? 0.55 : 0.4} stroke-width="1.3" vector-effect="non-scaling-stroke" />
            ))}
          </svg>
          <span class="relative grid h-20 w-20 place-items-center rounded-full border border-silver-300 bg-white/80 font-display text-[1.75rem] font-extrabold tracking-[-0.03em] text-navy-900">
            {getInitials(name)}
          </span>
        </div>
      )
    }
  </div>
  <div class="px-4 py-3.5 sm:px-5 sm:py-4">
    <h3 class="text-[1rem] leading-snug font-bold sm:text-[1.0625rem]">{name}</h3>
    {designation && <p class="mt-0.5 text-sm text-ink-500">{designation}</p>}
  </div>
</li>
