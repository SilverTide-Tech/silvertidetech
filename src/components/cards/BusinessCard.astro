---
/**
 * Business (vertical) card (brand-direction §8.1). The heading link is stretched over the card,
 * so the whole card is clickable while keeping a short accessible name.
 */
import StatusBadge from '../ui/StatusBadge.astro';
import TideStroke from '../ui/TideStroke.astro';
import type { Status } from '../../lib/status';

interface Offering {
  name: string;
  status?: Status;
}

interface Props {
  name: string;
  href: string;
  eyebrow: string;
  purpose: string;
  /** Planned verticals show a single Planned badge; active ones show a summary line. */
  status?: Status;
  summary?: string;
  offerings: Offering[];
  linkLabel: string;
  icon: 'education' | 'code';
}

const { name, href, eyebrow, purpose, status, summary, offerings, linkLabel, icon } = Astro.props;
const planned = status === 'planned';
---

<article
  class:list={[
    'card-glow group relative flex flex-col gap-4 rounded-[var(--radius-card)] border border-silver-200 p-6 transition-[border-color,box-shadow,transform] duration-300 ease-[var(--ease-tide-out)] hover:-translate-y-0.5 hover:border-silver-300 hover:shadow-[0_22px_40px_-28px_rgba(11,31,58,0.35)] focus-within:border-silver-300 sm:p-9',
    planned ? 'bg-gradient-to-b from-white to-mist' : 'bg-white',
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span class="grid h-13 w-13 place-items-center rounded-[14px] bg-mist text-navy-900" aria-hidden="true">
      {
        icon === 'education' ? (
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8.5 12 4l9 4.5-9 4.5-9-4.5Z" />
            <path d="M7 10.5V15c0 1.4 2.2 3 5 3s5-1.6 5-3v-4.5" />
            <path d="M21 8.5V14" />
          </svg>
        ) : (
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 8-4 4 4 4" />
            <path d="m16 8 4 4-4 4" />
            <path d="m13.5 5-3 14" />
          </svg>
        )
      }
    </span>
    {status && <StatusBadge status={status} />}
    {!status && summary && <span class="status-badge bg-status-live-bg text-status-live" data-status="available-now">{summary}</span>}
  </div>

  <p class="eyebrow text-teal-700">{eyebrow}</p>
  <TideStroke />
  <h3 class="text-[1.625rem] leading-tight font-bold">
    <a href={href} class="after:absolute after:inset-0 after:rounded-[var(--radius-card)] focus-visible:outline-none">{name}</a>
  </h3>
  <p>{purpose}</p>

  <ul class="mt-1 grid text-[0.9375rem]">
    {
      offerings.map((o) => (
        <li class="flex items-center justify-between gap-3 border-t border-silver-200 py-2.5">
          <span class="text-ink-700">{o.name}</span>
          {o.status && !planned && <StatusBadge status={o.status} />}
        </li>
      ))
    }
  </ul>

  <span class="tide-link mt-auto self-start pt-2" aria-hidden="true">{linkLabel} <span>→</span></span>
</article>

<style>
  /* Keyboard focus on the stretched link outlines the whole card. */
  article:has(h3 a:focus-visible) {
    outline: 3px solid var(--color-teal-700);
    outline-offset: 3px;
  }
</style>
