---
/** Titled points in a grid: pillars, identity points, horizons. */
import TideStroke from '../ui/TideStroke.astro';

interface Props {
  items: ReadonlyArray<{ title: string; text: string }>;
  columns?: 2 | 3 | 4;
  /** Render titles in the mono eyebrow style (e.g. Now / Next / Later). */
  labelStyle?: boolean;
}

const { items, columns = 3, labelStyle = false } = Astro.props;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[columns];
---

<ul class:list={['grid gap-4 sm:gap-5', cols]}>
  {
    items.map((item) => (
      <li class="grid content-start gap-3 rounded-[var(--radius-card)] border border-silver-200 bg-white p-6 sm:p-7">
        <TideStroke />
        <h3 class:list={labelStyle ? 'eyebrow text-teal-700' : 'text-h3 font-semibold'}>{item.title}</h3>
        <p class:list={[labelStyle && 'font-display text-[1.1875rem] leading-snug font-semibold text-navy-900']}>{item.text}</p>
      </li>
    ))
  }
</ul>
